<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2 mt-3">
        <br>
        <h3>Create New Listing</h3> <br>
        <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

            <div class="mb-3">
                <label for="text" class="form-label">Title : </label>
                <input type="text" name="listing[title]" placeholder="Enter Title" class="form-control" id="text" required>
                <div class="invalid-feedback">
                    Title should be valid
                </div>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>

            <div class="mb-3">    
                <label for="description" class="form-label">Description : </label>
                <textarea name="listing[description]" placeholder="Enter Description" class="form-control" id="description" required></textarea>
                <div class="invalid-feedback">
                    Description should be valid
                </div>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Upload Image : </label>
                <input type="file" name="listing[image]" class="form-control" id="image" required>
            </div>
                
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price : </label>
                    <input  name="listing[price]" placeholder="1200" id="price" class="form-control" required >
                    <div class="invalid-feedback">
                        Price should be valid
                    </div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country : </label>
                    <input type="text" name="listing[country]" placeholder="India" class="form-control" id="country" required>
                    <div class="invalid-feedback">
                        Country should be valid
                    </div>
                </div>
            </div>
            
                
            <div class="mb-3">
                <label for="location" class="form-label">Location : </label>
                <input type="text" name="listing[location]" placeholder="Enter Location" class="form-control" id="location" required>
                <div class="invalid-feedback">
                    Location should be valid
                </div>
            </div>

            <div class="mb-3">
                <label for="categories" class="form-label">Categories : </label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Trending" id="checkDefault" name="listing[categories][]">
                    <label class="form-check-label" for="checkDefault">
                        Trending
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Rooms" id="checkChecked" name="listing[categories][]">
                    <label class="form-check-label" for="checkChecked">
                        Rooms
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Iconic Cities" id="checkIconic" name="listing[categories][]">
                    <label class="form-check-label" for="checkIconic">
                        Iconic Cities
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Mountains" id="checkMountains" name="listing[categories][]">
                    <label class="form-check-label" for="checkMountains">
                        Mountains
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Castles" id="checkCastles" name="listing[categories][]">
                    <label class="form-check-label" for="checkCastles">
                        Castles
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Amazing Pools" id="checkAmazingPools" name="listing[categories][]">
                    <label class="form-check-label" for="checkAmazingPools">
                        Amazing Pools
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Camping" id="checkCamping" name="listing[categories][]">
                    <label class="form-check-label" for="checkCamping">
                        Camping
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Farms" id="checkFarms" name="listing[categories][]">
                    <label class="form-check-label" for="checkFarms">
                        Farms
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Arctic" id="checkArctic" name="listing[categories][]">
                    <label class="form-check-label" for="checkArctic">
                        Arctic
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Domes" id="checkDomes" name="listing[categories][]">
                    <label class="form-check-label" for="checkDomes">
                        Domes
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Boats" id="checkBoats" name="listing[categories][]">
                    <label class="form-check-label" for="checkBoats">
                        Boats
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="Others" id="checkOthers" name="listing[categories][]">
                    <label class="form-check-label" for="checkOthers">
                        Others
                    </label>
                </div>

            </div>
                

            
            
            <button class="btn btn-dark add-btn mt-3">Submit</button>
            <br><br>
        </form>
    </div>
</div>



